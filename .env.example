# Copy to .env; loaded by the backend only. Never use a VITE_ prefix for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SCHEDULE_VISION_API_KEY=
SCHEDULE_VISION_MODEL=deepseek-flash
SCHEDULE_VISION_BASE_URL=https://api.deepseek.com
# Campus login email delivery (not needed in DEMO_MODE)
SMTP_URL=
MAIL_FROM=
# Optional: DB_PATH=/absolute/path/to/map.db
# Demo clock / fixtures: use with DB_PATH=server/demo.db after running
# `node scripts/seed-demo.mjs`; the server only honors crowd `at` timestamps
# when this is exactly true.
DEMO_MODE=false
# PORT=8790
# Event data pipeline (server/eventPipeline.mjs). The official website source needs no config.
# Email source: IMAP mailbox that receives school activity notices (163 needs an authorization code, not the login password)
EVENT_IMAP_URL=
# EVENT_IMAP_MAILBOX=INBOX
# Only mail from senders matching this regex is parsed
# EVENT_MAIL_SENDERS=shanghaitech\.edu\.cn
# How far back the first run looks, and run intervals in minutes
# EVENT_IMAP_SINCE_DAYS=30
# EVENT_IMAP_INTERVAL_MIN=30
# EVENT_OFFICIAL_INTERVAL_MIN=120
# Set to false to skip the run 5 seconds after startup
# EVENT_SYNC_ON_START=true
